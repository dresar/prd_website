<%- include('../partials/panel-header', { title }) %>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
      <div><h3><%= stats.users %></h3><p>Pengguna</p></div>
    </div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-envelope-heart"></i></div>
      <div><h3><%= stats.published %></h3><p>Undangan terbit</p></div>
    </div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-secondary-subtle text-secondary"><i class="bi bi-stack"></i></div>
      <div><h3><%= stats.invitations %></h3><p>Total undangan</p></div>
    </div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-person-lines-fill"></i></div>
      <div><h3><%= stats.guests %></h3><p>Tamu</p></div>
    </div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-ui-checks"></i></div>
      <div><h3><%= stats.rsvps %></h3><p>RSVP</p></div>
    </div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-chat-heart"></i></div>
      <div><h3><%= stats.wishes %></h3><p>Ucapan</p></div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-person-plus me-2"></i>Pengguna Terbaru</span>
        <a href="/admin/pengguna" class="small fw-semibold text-decoration-none">Kelola →</a>
      </div>
      <div class="list-group list-group-flush">
        <% latestUsers.forEach((u) => { %>
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
              <span class="avatar-sm"><%= u.name.charAt(0).toUpperCase() %></span>
              <div>
                <b class="small"><%= u.name %></b>
                <div class="text-muted" style="font-size:0.78rem"><%= u.email %></div>
              </div>
            </div>
            <div class="text-end">
              <% if (u.role === 'admin') { %><span class="badge text-bg-dark">Admin</span><% } %>
              <% if (!u.is_active) { %><span class="badge text-bg-danger">Nonaktif</span><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-envelope-heart me-2"></i>Undangan Terbaru</span>
        <a href="/admin/undangan" class="small fw-semibold text-decoration-none">Kelola →</a>
      </div>
      <div class="list-group list-group-flush">
        <% latestInvs.forEach((i) => { %>
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <b class="small"><%= i.title || i.slug %></b>
              <div class="text-muted" style="font-size:0.78rem">oleh <%= i.owner_name %></div>
            </div>
            <% if (i.status === 'published') { %><span class="badge text-bg-success">Terbit</span>
            <% } else { %><span class="badge text-bg-secondary">Draf</span><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/panel-footer') %>
