<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — <%= site.site_name || 'UndanganKu' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app-body">
<div class="app-wrapper">
  <aside class="app-sidebar" id="sidebar">
    <a class="sidebar-brand" href="/">
      <span class="brand-mark"><i class="bi bi-heart-fill"></i></span>
      <span class="brand-text"><%= site.site_name || 'UndanganKu' %></span>
    </a>
    <nav class="sidebar-nav">
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a class="<%= active === 'dashboard' ? 'active' : '' %>" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a class="<%= active === 'users' ? 'active' : '' %>" href="/admin/pengguna"><i class="bi bi-people"></i> Pengguna</a>
        <a class="<%= active === 'invitations' ? 'active' : '' %>" href="/admin/undangan"><i class="bi bi-envelope-heart"></i> Undangan</a>
        <a class="<%= active === 'themes' ? 'active' : '' %>" href="/admin/tema"><i class="bi bi-palette"></i> Tema</a>
        <a class="<%= active === 'settings' ? 'active' : '' %>" href="/admin/pengaturan"><i class="bi bi-gear"></i> Pengaturan Situs</a>
      <% } else { %>
        <a class="<%= active === 'dashboard' ? 'active' : '' %>" href="/panel"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a class="<%= active === 'undangan' ? 'active' : '' %>" href="/panel/undangan"><i class="bi bi-envelope-heart"></i> Undangan Saya</a>
        <a class="<%= active === 'profil' ? 'active' : '' %>" href="/panel/profil"><i class="bi bi-person-circle"></i> Profil</a>
      <% } %>
    </nav>
    <div class="sidebar-foot">
      <a href="/" target="_blank"><i class="bi bi-box-arrow-up-right"></i> Lihat Situs</a>
    </div>
  </aside>

  <div class="app-main">
    <header class="app-topbar">
      <button class="btn btn-light d-lg-none" data-toggle-sidebar aria-label="Menu"><i class="bi bi-list fs-4"></i></button>
      <div class="topbar-title d-none d-sm-block"><%= title %></div>
      <div class="ms-auto dropdown">
        <button class="btn btn-light d-flex align-items-center gap-2 border" data-bs-toggle="dropdown">
          <span class="avatar-sm"><%= (currentUser ? currentUser.name : '?').charAt(0).toUpperCase() %></span>
          <span class="d-none d-md-inline fw-semibold"><%= currentUser ? currentUser.name : '' %></span>
          <% if (currentUser && currentUser.role === 'admin') { %><span class="badge text-bg-dark">Admin</span><% } %>
          <i class="bi bi-chevron-down small"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
          <% if (currentUser && currentUser.role === 'admin') { %>
            <li><a class="dropdown-item" href="/admin/pengaturan"><i class="bi bi-gear me-2"></i>Pengaturan Situs</a></li>
          <% } else { %>
            <li><a class="dropdown-item" href="/panel/profil"><i class="bi bi-person me-2"></i>Profil Saya</a></li>
          <% } %>
          <li><a class="dropdown-item" href="/" target="_blank"><i class="bi bi-globe2 me-2"></i>Lihat Situs</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" href="/auth/keluar"><i class="bi bi-box-arrow-right me-2"></i>Keluar</a></li>
        </ul>
      </div>
    </header>

    <main class="app-content">
      <% if (flash) { %>
        <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show" role="alert">
          <%= flash.msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
        </div>
      <% } %>
